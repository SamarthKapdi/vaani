# ==============================================================================
# Vaani Environment Configuration
# ==============================================================================
# Obtain a free Groq API key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional: Whisper model name on Groq (default: whisper-large-v3)
GROQ_MODEL=whisper-large-v3

# Server port (default: 8000)
PORT=8000
